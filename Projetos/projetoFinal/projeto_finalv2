        self.tab_container.grid_rowconfigure(0, weight=1)
        
        self.tabs = {
            "dashboard": DashboardTab(self.tab_container, self),
            "pets": PetsTab(self.tab_container, self),
            "appointments": AppointmentsTab(self.tab_container, self),
            "health": HealthTab(self.tab_container, self),
            "reports": ReportsTab(self.tab_container, self),
            "settings": SettingsTab(self.tab_container, self),
        }
        self.current_active_tab = None
    
    def on_show(self):
        if self.controller.current_user:
            user = self.controller_user
            self.profile_card.configure(text= f"👤 Treinador: {user['name']} \n - Online (@{user['username']})")
            self.switch_tab("dashboard")
        
    def switch_tab(self, tab_key):
        if self.current_active_tab is not None:
            self.current_active_tab.grid_forget()

        for key, btn in self.nav_buttons.items():
            if key == tab_key:
                btn.configure(
                    fg_color=(self.controller.theme["card_light"], self.controller.theme["card_dark"]),
                    text_color=self.controller.theme["primary"],
                    font=ctk.CTkFont(size=14, weight="bold")
                )
            else:
                btn.configure(
                    fg_color="transparent",
                    text_color=("gray30", "gray70"),
                    font=ctk.CTkFont(size=14, weight="normal")
                )

        target_tab = self.tabs[tab_key]
        self.current_active_tab = target_tab
        target_tab.grid(row=0, column=0, sticky="nsew")

        if hasattr(target_tab, "refresh"):
            target_tab.refresh() 
            
    def confirm_logout(self):
        dialog = ctk.CTkToplevel(self)
         
    def apply_theme(self, theme):
        self.sidebar.configure(fg_color=(theme["sidebar_light"], theme["sidebar_dark"]))
        self.logo_label.configure(text_color=theme["primary"])
        self.theme_menu.configure(fg_color=theme["primary"], button_color=theme["hover"])
        self.mode_menu.configure(fg_color=theme["primary"], button_color=theme["hover"])
        self.profile_card.configure(fg_color=(theme["card_light"], theme["card_dark"]), text_color=(theme["primary"], "#FFFFFF"))
        
        for tab in self.tabs.values():
            if hasattr(tab, "apply_theme"):
                tab.apply_theme(theme)
    

    @staticmethod
    def get_appointments(user_id):
        with Database.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT id, pet_name, service_type, app_date, status FROM appointments WHERE user_id = ? ORDER BY id DESC", (user_id,))
            return cursor.fetchall()

    @staticmethod
    def add_health_record(user_id, pet_name, record_type, description, record_date):
        with Database.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("""
                INSERT INTO health_records (user_id, pet_name, record_type, description, record_date)
                VALUES (?, ?, ?, ?, ?)
            """, (user_id, pet_name, record_type, description, record_date))
            cursor.execute("""
                INSERT INTO activities (user_id, icon, description, time_ago)
                VALUES (?, ?, ?, ?)
            """, (user_id, "🩺", f"Registro médico ({record_type}) para {pet_name}.", "Agora mesmo"))

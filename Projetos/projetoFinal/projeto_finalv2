class ReportsTab(ctk.CTkScrollableFrame):
    def __init__(self, parent, container):
        super().__init__(parent, fg_color="transparent")
        self.container = container
        self.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(self, text="📄 Relatórios & Sumário Geral", font=ctk.CTkFont(size=22, weight="bold")).pack(anchor="w", pady=(5, 15))

        self.summary_card = ctk.CTkFrame(self, corner_radius=16, border_width=1)
        self.summary_card.pack(fill="x", pady=10, padx=5)

        self.summary_text = ctk.CTkLabel(self.summary_card, text="", justify="left", font=ctk.CTkFont(size=14))
        self.summary_text.pack(padx=20, pady=20, anchor="w")

    def refresh(self):
        user = self.container.controller.current_user
        if not user:
            return

        tot, prox, hoje, alert = Database.get_dashboard_metrics(user["id"])
        pets = Database.get_pets(user["id"])
        
        species_count = {}
        for p in pets:
            spec = p[2]
            species_count[spec] = species_count.get(spec, 0) + 1

        dist = "\n".join([f"  • {k}: {v}" for k, v in species_count.items()]) if species_count else "  • Nenhum animal cadastrado."

        text = (
            f"Relatório de Gestão do Centro:\n\n"
            f"• Responsável: {user['name']} (@{user['username']})\n"
            f"• Email de Contato: {user['email']}\n"
            f"• Telefone: {user['phone'] or 'Não informado'}\n"
            f"• Endereço: {user['address'] or 'Não informado'}\n\n"
            f"Estatísticas Gerais:\n"
            f"• Total de Pets Registrados: {tot}\n"
            f"• Agendamentos Pendentes: {prox}\n"
            f"• Atendimentos de Hoje: {hoje}\n"
            f"• Pets sob Alerta / Cuidados Especiais: {alert}\n\n"
            f"Distribuição por Categoria/Espécie:\n{dist}"
        )
        self.summary_text.configure(text=text)

    def apply_theme(self, theme):
        self.summary_card.configure(fg_color=(theme["card_light"], theme["card_dark"]), border_color=theme["primary"])



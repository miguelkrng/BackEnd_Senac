class Database:
    @staticmethod
    def get_connection():
        return sqlite3.connect("petopia.db")

    @staticmethod
    def init_db():
        with Database.get_connection() as conn:
            cursor = conn.cursor()
            
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS users (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT NOT NULL,
                    username TEXT UNIQUE NOT NULL,
                    email TEXT UNIQUE NOT NULL,
                    password TEXT NOT NULL,
                    phone TEXT,
                    address TEXT,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """)

            cursor.execute("""
                CREATE TABLE IF NOT EXISTS pets (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER NOT NULL,
                    name TEXT NOT NULL,
                    species TEXT NOT NULL,
                    breed TEXT NOT NULL,
                    age TEXT NOT NULL,
                    icon TEXT NOT NULL,
                    image_path TEXT DEFAULT '',
                    status TEXT DEFAULT 'Ativo',
                    has_alert INTEGER DEFAULT 0,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY(user_id) REFERENCES users(id)
                )
            """)

            try:
                cursor.execute("ALTER TABLE pets ADD COLUMN image_path TEXT DEFAULT ''")
            except sqlite3.OperationalError:
                pass

            cursor.execute("""
                CREATE TABLE IF NOT EXISTS custom_species (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT UNIQUE NOT NULL
                )
            """)

            cursor.execute("""
                CREATE TABLE IF NOT EXISTS custom_icons (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT UNIQUE NOT NULL
                )
            """)

            cursor.execute("""
                CREATE TABLE IF NOT EXISTS appointments (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER NOT NULL,
                    pet_name TEXT NOT NULL,
                    service_type TEXT NOT NULL,
                    app_date TEXT NOT NULL,
                    status TEXT DEFAULT 'Pendente',
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY(user_id) REFERENCES users(id)
                )
            """)

            cursor.execute("""
                CREATE TABLE IF NOT EXISTS health_records (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER NOT NULL,
                    pet_name TEXT NOT NULL,
                    record_type TEXT NOT NULL,
                    description TEXT NOT NULL,
                    record_date TEXT NOT NULL,
                    FOREIGN KEY(user_id) REFERENCES users(id)
                )
            """)

            cursor.execute("""
                CREATE TABLE IF NOT EXISTS activities (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER NOT NULL,
                    icon TEXT NOT NULL,
                    description TEXT NOT NULL,
                    time_ago TEXT NOT NULL,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY(user_id) REFERENCES users(id)
                )
            """)

            # Valores padrão para tipos de pets e categorias
            default_species = ["Pikachu", "Bulbassauro", "Eevee", "Fletchling", "Tandemaus", "Totodile", "Snom"]
            for s in default_species:
                cursor.execute("INSERT OR IGNORE INTO custom_species (name) VALUES (?)", (s,))

            default_icons = ["⚡ Elétrico", "🔥 Fogo", "🌿 Grama", "💧 Água", "❄️ Gelo", "🐦 Voador", "⭐ Normal"]
            for icon_name in default_icons:
                cursor.execute("INSERT OR IGNORE INTO custom_icons (name) VALUES (?)", (icon_name,))

            conn.commit()

    # Operações de Usuário
    @staticmethod
    def register_user(name, username, email, password, phone, address):
        try:
            with Database.get_connection() as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    INSERT INTO users (name, username, email, password, phone, address)
                    VALUES (?, ?, ?, ?, ?, ?)
                """, (name.strip(), username.strip().lower(), email.strip().lower(), password, phone.strip(), address.strip()))
                conn.commit()
                return True, "Cadastro realizado com sucesso!"
        except sqlite3.IntegrityError as e:
            if "username" in str(e):
                return False, "Este nome de usuário já está em uso!"
            return False, "Este email já está cadastrado!"
        except Exception as e:
            return False, f"Erro: {str(e)}"

    @staticmethod
    def authenticate_user(login_identifier, password):
        with Database.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("""
                SELECT id, name, username, email, phone, address 
                FROM users 
                WHERE (email = ? OR username = ?) AND password = ?
            """, (login_identifier.strip().lower(), login_identifier.strip().lower(), password))
            user = cursor.fetchone()
            if user:
                return True, {
                    "id": user[0], "name": user[1], "username": user[2],
                    "email": user[3], "phone": user[4], "address": user[5]
                }
            return False, "Credenciais inválidas!"

    @staticmethod
    def update_user(user_id, name, email, phone, address):
        try:
            with Database.get_connection() as conn:
                cursor = conn.cursor()
                cursor.execute("""
                    UPDATE users SET name = ?, email = ?, phone = ?, address = ? WHERE id = ?
                """, (name.strip(), email.strip().lower(), phone.strip(), address.strip(), user_id))
                conn.commit()
                return True, "Perfil atualizado com sucesso!"
        except sqlite3.IntegrityError:
            return False, "Este email já pertence a outro usuário!"
        except Exception as e:
            return False, str(e)

    # Operações de Pets
    @staticmethod
    def add_pet(user_id, name, species, breed, age, icon, image_path, has_alert):
        with Database.get_connection() as conn:
            cursor = conn.cursor()
            status = "Alerta!" if has_alert else "Ativo"
            cursor.execute("""
                INSERT INTO pets (user_id, name, species, breed, age, icon, image_path, status, has_alert)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (user_id, name, species, breed, age, icon, image_path, status, 1 if has_alert else 0))
            
            cursor.execute("""
                INSERT INTO activities (user_id, icon, description, time_ago)
                VALUES (?, ?, ?, ?)
            """, (user_id, "🐾", f"{name} ({species}) foi registrado.", "Agora mesmo"))
            conn.commit()

    @staticmethod
    def update_pet(pet_id, user_id, name, species, breed, age, icon, image_path, has_alert):
        with Database.get_connection() as conn:
            cursor = conn.cursor()
            status = "Alerta!" if has_alert else "Ativo"
            cursor.execute("""
                UPDATE pets 
                SET name = ?, species = ?, breed = ?, age = ?, icon = ?, image_path = ?, status = ?, has_alert = ?
                WHERE id = ? AND user_id = ?
            """, (name, species, breed, age, icon, image_path, status, 1 if has_alert else 0, pet_id, user_id))
            
            cursor.execute("""
                INSERT INTO activities (user_id, icon, description, time_ago)
                VALUES (?, ?, ?, ?)
            """, (user_id, "✏️", f"Informações de {name} foram atualizadas.", "Agora mesmo"))

            self.switch_tab("dashboard")
        
    def switch_tab(self, tab_key):
        if self.current_active_tab is not None:
            self.current_active_tab.grid_forget()

        for key, btn in self.nav_buttons.items():
            if key == tab_key:
                btn.configure(
                    fg_color=(self.controller.theme["card_light"], self.controller.theme["card_dark"]),
                    text_color=self.controller.theme["primary"],
                    font=ctk.CTkFont(size=14, weight="bold")
                )
            else:
                btn.configure(
                    fg_color="transparent",
                    text_color=("gray30", "gray70"),
                    font=ctk.CTkFont(size=14, weight="normal")
                )

        target_tab = self.tabs[tab_key]
        self.current_active_tab = target_tab
        target_tab.grid(row=0, column=0, sticky="nsew")

        if hasattr(target_tab, "refresh"):
            target_tab.refresh()
            
    def confirm_logout(self):
        dialog = ctk.CTkToplevel(self) 
        dialog.title("Encerrar Sessao")
        dialog.geometry("300x200")
        dialog.transient(self)
        dialog.grab_set()
        dialog.resizable(False, False) 
        
        dialog.update_idletasks()
        x= self.winfo_x() + (self.winfo_width() // 2) - 190
        y= self.winfo_y() + (self.winfo_height() // 2) -100
        dialog.geometry(f"+{x}+{y}")
        
        ctk.CTkLabel(
            dialog, text="Tem certeza que deseja encerrar a sessão?",
            font= ctk.CTkFont(size=18, weight="bold")
        ).pack(pady=(25,8))
        
        user_name = self.controller.current_user["name"] if self.controller.current_user else "Usuario"
        ctk.CTkLabel(
            dialog, text=f"Ate logo, {user_name}! Voce retornara a tela de login.",
            font= ctk.CTkFont(size=13), text_color="gray60"
        ).pack(pady=(0, 20))
        
        btn_box = ctk.CTkFrame(dialog, fg_color="transparent")
        btn_box.pack(fill="x", padx=30)
        
        def proceed_logout():
            dialog.destroy()
            self.controller.current_user = None
            self.controller.show_frame("LoginFrame")
            
        ctk.CTkButton(
            btn_box, text="Cancelar", width=140, height=38, fg_color="transparent", border_width=1, border_color= "gray50", command=dialog.destroy
        ).pack(side="right", padx=5)
        
        ctk.CTkButton(
            btn_box, text="Sim. sair", width=140, height=38, fg_color="#EF4444", hover_color="#DC2626", command=proceed_logout
        ).pack(side="right", padx=5)
        
    def apply_theme(self, theme):
        self.sidebar.configure(fg_color=(theme["sidebar_light"], theme["sidebar_dark"]))
        self.logo_label.configure(text_color=theme["primary"])
        self.theme_menu.configure(fg_color=theme["primary"], button_color=theme["hover"])
        self.mode_menu.configure(fg_color=theme["primary"], button_color=theme["hover"])
        self.profile_card.configure(fg_color=(theme["card_light"], theme["card_dark"]), text_color=(theme["primary"], "#FFFFFF"))
        
        for tab in self.tabs.values():
            if hasattr(tab, "apply_theme"):
                tab.apply_theme(theme)
    

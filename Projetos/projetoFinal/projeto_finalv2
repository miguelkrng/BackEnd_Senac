        self.title_label = ctk.CTkLabel(
            self.card, text="🐾 PokeCentro - Login", 
            font=ctk.CTkFont(size=24, weight="bold")
        )
        self.title_label.pack(pady=(45, 6))

        self.subtitle = ctk.CTkLabel(
            self.card, text="Gerenciador de Pokémons", 
            font=ctk.CTkFont(size=13), text_color="gray60"
        )
        self.subtitle.pack(pady=(0, 15))

        self.feedback = ctk.CTkLabel(self.card, text="", font=ctk.CTkFont(size=13))
        self.feedback.pack(pady=(0, 10))

        self.login_entry = ctk.CTkEntry(
            self.card, width=340, height=48, 
            placeholder_text="Email ou Nome de Usuário",
            font=ctk.CTkFont(size=14)
        )
        self.login_entry.pack(pady=8)

        self.pass_entry = ctk.CTkEntry(
            self.card, width=340, height=48, 
            placeholder_text="Senha de Acesso", 
            show="•", font=ctk.CTkFont(size=14)
        )
        self.pass_entry.pack(pady=8)

        self.btn_login = ctk.CTkButton(
            self.card, text="Acessar Sistema", 
            width=340, height=50, font=ctk.CTkFont(size=15, weight="bold"),
            text_color="#000000", command=self.handle_login
        )
        self.btn_login.pack(pady=(25, 12))

        self.btn_goto_register = ctk.CTkButton(
            self.card, text="Novo no Centro? Cadastre-se", 
            fg_color="transparent", font=ctk.CTkFont(size=13),
            command=lambda: self.controller.show_frame("RegisterFrame")
        )
        self.btn_goto_register.pack()

    def on_show(self):
        self.feedback.configure(text="")
        self.pass_entry.delete(0, "end")

    def handle_login(self):
        ident = self.login_entry.get().strip()
        pwd = self.pass_entry.get()

        if not ident or not pwd:
            self.feedback.configure(text="Preencha todos os campos!", text_color="#EF4444")
            return

        success, result = Database.authenticate_user(ident, pwd)
        if success:
            self.controller.current_user = result
            self.controller.show_frame("HomeContainerFrame")
        else:
            self.feedback.configure(text=result, text_color="#EF4444")

    def apply_theme(self, theme):
        self.card.configure(
            fg_color=(theme["card_light"], theme["card_dark"]),
            border_color=theme["primary"]
        )
        self.title_label.configure(text_color=theme["primary"])
        self.btn_login.configure(fg_color=theme["primary"], hover_color=theme["hover"])
        self.btn_goto_register.configure(text_color=theme["primary"])



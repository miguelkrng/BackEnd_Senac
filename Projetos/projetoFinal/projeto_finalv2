class App(ctk.CTk):
    def __init__(self):
        super().__init__()

        Database.init_db()

        self.title("- PokePet -")
        self.geometry("1240x780")
        self.minsize(1050, 680)

        self.current_theme_name = "❄️ Ciano Aurorus"
        self.theme = THEMES[self.current_theme_name]
        self.current_user = None

        self.container = ctk.CTkFrame(self, fg_color="transparent")
        self.container.pack(fill="both", expand=True)
        self.container.grid_rowconfigure(0, weight=1)
        self.container.grid_columnconfigure(0, weight=1)

        self.frames = {}
        for FrameClass in (LoginFrame, RegisterFrame, HomeContainerFrame):
            page_name = FrameClass.__name__
            frame = FrameClass(parent=self.container, controller=self)
            self.frames[page_name] = frame

        self.current_frame = None
        self.apply_theme()
        self.show_frame("LoginFrame")

    def show_frame(self, page_name, **kwargs):
        if self.current_frame is not None:
            self.current_frame.grid_forget()
            
        frame = self.frames[page_name]
        self.current_frame = frame
        frame.grid(row=0, column=0, sticky="nsew")
        
        if hasattr(frame, "on_show"):
            frame.on_show(**kwargs)

    def set_theme(self, theme_name):
        self.current_theme_name = theme_name
        self.theme = THEMES[theme_name]
        self.apply_theme()

    def apply_theme(self):
        t = self.theme
        self.configure(fg_color=(t["bg_light"], t["bg_dark"]))
        for frame in self.frames.values():
            if hasattr(frame, "apply_theme"):
                frame.apply_theme(t)



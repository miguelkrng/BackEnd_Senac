# 3. HELPER: RENDERIZADOR GARANTIDO DE IMAGENS/AVATARES
# =====================================================================
def create_avatar_component(parent, image_path, fallback_icon, size=(52, 52)):
    """
    Cria e retorna um CTkLabel renderizando a imagem via ImageTk.PhotoImage
    se o arquivo for válido, ou exibe o ícone caso contrário.
    """
    if image_path and os.path.isfile(image_path):
        try:
            pil_img = Image.open(image_path).convert("RGB")
            # Recorta centralizado (formato quadrado perfeito)
            w, h = pil_img.size
            min_dim = min(w, h)
            left = (w - min_dim) / 2
            top = (h - min_dim) / 2
            right = (w + min_dim) / 2
            bottom = (h + min_dim) / 2
            pil_img = pil_img.crop((left, top, right, bottom))
            pil_img = pil_img.resize(size, Image.Resampling.LANCZOS)
            
            photo = ctk.CTkImage(
                light_image=pil_img,
                dark_image=pil_img,
                size=size
            )
            lbl = ctk.CTkLabel(parent, text="", image=photo, width=size[0], height=size[1])
            lbl.img_ref = photo  # Salva a referência estrita para evitar garbage collection
            return lbl
        except Exception:
            pass

    font_sz = int(size[1] * 0.52)
    return ctk.CTkLabel(
        parent, text=fallback_icon,
        font=ctk.CTkFont(size=font_sz),
        width=size[0], height=size[1]
    )



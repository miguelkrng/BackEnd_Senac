        address = self.address_entry.get().strip()

        if not all([name, user, email, pwd]):
            self.feedback.configure(text="Preencha Nome, Usuário, Email e Senha!", text_color="#EF4444")
            return

        if len(pwd) < 4:
            self.feedback.configure(text="A senha deve ter ao menos 4 caracteres!", text_color="#EF4444")
            return

        success, msg = Database.register_user(name, user, email, pwd, phone, address)
        if success:
            self.controller.show_frame("LoginFrame")
            lf = self.controller.frames["LoginFrame"]
            lf.feedback.configure(text="Cadastro realizado com sucesso! Faça login.", text_color="#10B981")
            lf.login_entry.delete(0, "end")
            lf.login_entry.insert(0, user)
        else:
            self.feedback.configure(text=msg, text_color="#EF4444")

    def apply_theme(self, theme):
        self.card.configure(
            fg_color=(theme["card_light"], theme["card_dark"]),
            border_color=theme["primary"]
        )
        self.title_label.configure(text_color=theme["primary"])
        self.btn_submit.configure(fg_color=theme["primary"], hover_color=theme["hover"])
        self.btn_back.configure(text_color=theme["primary"])
        

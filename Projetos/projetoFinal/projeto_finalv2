    def refresh (self):
        user = self.container.controller.current_user
        if not user:
            return

        self.welcome_title.configure(text=f"Olá, {user['name'].split()[0]}! Seus pokémons estão sob cuidado.")
            
        tot, prox, hoje, alert = Database.get_dashboard_metrics(user['id'])    
        self.metric_cards["total_pets"][1].configure(text=str(tot))    
        self.metric_cards["prox"][1].configure(text=str(prox))    
        self.metric_cards["hoje"][1].configure(text=str(hoje))
        self.metric_cards["alert"][1].configure(text=str(alert))        
        
        for widget in self.agend_list_frame.winfo_children():
            widget.destroy()
        
        agends = Database.get_appointments(user['id'])[:3]
        if not agends:
            ctk.CTkLabel(self.agend_list_frame, text="Nenhum agendamento pendente!", text_color="gray60").pack(pady=10)
        else:
            for _, pet_name, s_type, dt, status in agends:
                row = ctk.CTkFrame(self.agend_list_frame, corner_radius = 8)
                row.pack(fill="x", pady=3, ipady=4)
                ctk.CTkLabel(row, text=f"📅{dt}", font=ctk.CTkFont(size=12, weight="bold")).pack(side="left", padx=10)
                ctk.CTkLabel(row, text=f"{pet_name} ({s_type})", font=ctk.CTkFont(size=12)).pack(side="left", padx=10)
                ctk.CTkLabel(row, text=f"{status}", corner_radius=6, fg_color="#451A03", text_color="#FDBA74", font=ctk.CTkFont(size=11, weight="bold")).pack(side="right", padx=10)
        
        for widget in self.ativ_list_frame.winfo_children():
            widget.destroy()
        
        acts = Database.get_activities(user["id"], limit=3)
        if not acts:
            ctk.CTkLabel(self.ativ_list_frame, text="Nenhuma atividade recente.", text_color="gray60").pack(pady=10)
        else:
            for icon, desc, tm in acts:
                item = ctk.CTkFrame(self.ativ_list_frame, fg_color="transparent")
                item.pack(fill="x", pady=4)
                ctk.CTkLabel(item, text=icon, font=ctk.CTkFont(size=18)).pack(side="left", padx=(0, 8))
                box = ctk.CTkFrame(item, fg_color="transparent")
                box.pack(side="left")
                ctk.CTkLabel(box, text=desc, font=ctk.CTkFont(size=12, weight="bold")).pack(anchor="w")
                ctk.CTkLabel(box, text=tm, font=ctk.CTkFont(size=10), text_color="gray60").pack(anchor="w")

        for widget in self.pets_grid_frame.winfo_children():
            widget.destroy()

        pets = Database.get_pets(user["id"])[:4]
        if not pets:
            ctk.CTkLabel(self.pets_grid_frame, text="Nenhum Pokémon cadastrado.\nClique em '+ Adicionar Novo Pokémon'!", text_color="gray60").pack(pady=30)
        else:
            for idx, (_, name, species, breed, age, icon, image_path, status, has_alert) in enumerate(pets):
                r, c = idx // 2, idx % 2
                p_card = ctk.CTkFrame(self.pets_grid_frame, corner_radius=12)
                p_card.grid(row=r, column=c, padx=5, pady=5, sticky="nsew")

                top_f = ctk.CTkFrame(p_card, fg_color="transparent")
                top_f.pack(fill="x", padx=8, pady=(8, 4))
                
                # Exibição do Avatar (Foto real renderizada ou ícone)
                avatar = create_avatar_component(top_f, image_path, icon, size=(48, 48))
                avatar.pack(side="left", padx=(0, 8))
                
                info = ctk.CTkFrame(top_f, fg_color="transparent")
                info.pack(side="left")
                ctk.CTkLabel(info, text=name, font=ctk.CTkFont(size=13, weight="bold")).pack(anchor="w")
                ctk.CTkLabel(info, text=f"{species} • {breed}", font=ctk.CTkFont(size=10), text_color="gray60").pack(anchor="w")

                badge_bg = "#7C2D12" if has_alert else "#064E3B"
                badge_fg = "#FB923C" if has_alert else "#34D399"

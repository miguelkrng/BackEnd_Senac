    @staticmethod
    def get_health_records(user_id):
        with Database.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT id, pet_name, record_type, description, record_date FROM health_records WHERE user_id = ? ORDER BY id DESC", (user_id,))
            return cursor.fetchall()

    @staticmethod
    def get_activities(user_id, limit=4):
        with Database.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT icon, description, time_ago FROM activities WHERE user_id = ? ORDER BY id DESC LIMIT ?", (user_id, limit))
            return cursor.fetchall()

    @staticmethod
    def get_dashboard_metrics(user_id):
        with Database.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT COUNT(*) FROM pets WHERE user_id = ?", (user_id,))
            total_pets = cursor.fetchone()[0]

            cursor.execute("SELECT COUNT(*) FROM appointments WHERE user_id = ? AND status = 'Pendente'", (user_id,))
            prox_consultas = cursor.fetchone()[0]

            today = datetime.now().strftime("%d/%m")
            cursor.execute("SELECT COUNT(*) FROM appointments WHERE user_id = ? AND app_date LIKE ?", (user_id, f"{today}%"))
            atendimentos_hoje = cursor.fetchone()[0]

            cursor.execute("SELECT COUNT(*) FROM pets WHERE user_id = ? AND has_alert = 1", (user_id,))
            alertas = cursor.fetchone()[0]

            return total_pets, prox_consultas, atendimentos_hoje, alertas



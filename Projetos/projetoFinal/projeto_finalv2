    def start_edit_pet(self, pet_data):
            pet_id, name, species, breed, age, icon, image_path, status, has_alert = pet_data
            self.editing_pet_id = pet_id
            
            self.form_title.configure(text=f"✏️ Editando: {name}")
            self.btn_save_pet.configure(text="Salvar Alterações")
            self.btn_cancel_edit.pack(side="right", padx=(0, 10))

            self.name_entry.delete(0, "end")
            self.name_entry.insert(0, name)

            if species in self.species_entry.cget("values"):
                self.species_entry.set(species)

            self.breed_entry.delete(0, "end")
            self.breed_entry.insert(0, breed)

            self.age_entry.delete(0, "end")
            self.age_entry.insert(0, age)

            if icon in self.icon_entry.cget("values"):
                self.icon_entry.set(icon)

            if has_alert:
                self.alert_check.select()
            else:
                self.alert_check.deselect()

            self.selected_image_path = image_path or ""
            if image_path and os.path.isfile(image_path):
                self.img_path_label.configure(text=f"Foto atual: {os.path.basename(image_path)}", text_color="#34D399")
            else:
                self.img_path_label.configure(text="Nenhuma imagem selecionada (usará ícone)", text_color="gray60")

    def save_pet(self):
        user = self.container.controller.current_user
        name = self.name_entry.get().strip()
        species = self.species_entry.get()
        breed = self.breed_entry.get().strip()
        age = self.age_entry.get().strip()
        icon = self.icon_entry.get().split()[0]
        image_path = self.selected_image_path
        has_alert = self.alert_check.get() == 1

        if not name or not breed or not age:
            return

        if self.editing_pet_id is None:
            Database.add_pet(user["id"], name, species, breed, age, icon, image_path, has_alert)
        else:
            Database.update_pet(self.editing_pet_id, user["id"], name, species, breed, age, icon, image_path, has_alert)

        self.reset_form()
        self.refresh()

    def refresh(self):
        # Atualiza listas dinâmicas de tipos e categorias
        curr_species = self.species_entry.get()
        all_species = Database.get_species_list()
        self.species_entry.configure(values=all_species)
        if curr_species in all_species:
            self.species_entry.set(curr_species)
        elif all_species:
            self.species_entry.set(all_species[0])

        curr_icon = self.icon_entry.get()
        all_icons = Database.get_icons_list()
        self.icon_entry.configure(values=all_icons)
        if curr_icon in all_icons:
            self.icon_entry.set(curr_icon)
        elif all_icons:
            self.icon_entry.set(all_icons[0])

        for widget in self.pets_container.winfo_children():
            widget.destroy()

        user = self.container.controller.current_user
        if not user:
            return

        pets = Database.get_pets(user["id"])
        if not pets:
            ctk.CTkLabel(self.pets_container, text="Nenhum pet encontrado.", text_color="gray60").pack(pady=20)
            return

        for p in pets:
            pet_id, name, species, breed, age, icon, image_path, status, has_alert = p
            card = ctk.CTkFrame(self.pets_container, corner_radius=12, border_width=1)
            card.pack(fill="x", pady=6, padx=5)

            # Avatar renderizado real
            avatar = create_avatar_component(card, image_path, icon, size=(54, 54))
            avatar.pack(side="left", padx=15, pady=10)

            info = ctk.CTkFrame(card, fg_color="transparent")
            info.pack(side="left", fill="y", pady=10)
            ctk.CTkLabel(info, text=f"{name} ({species})", font=ctk.CTkFont(size=15, weight="bold")).pack(anchor="w")
            ctk.CTkLabel(info, text=f"Raça: {breed} | Idade/Nível: {age}", font=ctk.CTkFont(size=12), text_color="gray60").pack(anchor="w")

            badge_bg = "#7C2D12" if has_alert else "#064E3B"
            badge_fg = "#FB923C" if has_alert else "#34D399"
            ctk.CTkLabel(card, text=f" {status} ", font=ctk.CTkFont(size=11, weight="bold"), fg_color=badge_bg, text_color=badge_fg, corner_radius=6).pack(side="left", padx=20)

            # Ações: Editar e Remover
            btn_box = ctk.CTkFrame(card, fg_color="transparent")
            btn_box.pack(side="right", padx=15)

            ctk.CTkButton(
                btn_box, text="Editar", width=75, height=32,
                fg_color="transparent", border_width=1, border_color=self.container.controller.theme["primary"],
                text_color=self.container.controller.theme["primary"],
                command=lambda pet_data=p: self.start_edit_pet(pet_data)
            ).pack(side="left", padx=(0, 6))

            ctk.CTkButton(
                btn_box, text="Remover", width=75, height=32,
                fg_color="#EF4444", hover_color="#DC2626",
                command=lambda pid=pet_id: self.delete_pet(pid)
            ).pack(side="left")

    def delete_pet(self, pet_id):
        user = self.container.controller.current_user
        Database.delete_pet(pet_id, user["id"])
        self.refresh()

            
    def apply_theme(self, theme):
        self.form_card.configure(fg_color=(theme["card_light"], theme["card_dark"]), border_color=theme["primary"])
        self.btn_save_pet.configure(fg_color=theme["primary"], hover_color=theme["hover"])
        self.btn_upload.configure(fg_color=(theme["card_light"], theme["card_dark"]), border_width=1, border_color=theme["primary"], text_color=theme["primary"])


